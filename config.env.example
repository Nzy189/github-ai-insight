# ============================================================
# GitHub AI Insight — 环境变量模板
# NAS 部署用这个名字：把本文件改名为 config.env 放进挂载的数据目录。
# 不以点开头，极空间等 NAS 的文件管理器里直接可见可编辑。
# （本地开发用 .env 也行，两个都在时 config.env 优先）
#
# 本地测试可以什么都不填，直接跑 python main.py --now --mock
#
# Docker 里 .env 是以【文件】挂进容器的，改完 `docker compose restart`
# 即生效，不需要 up -d 重建。例外见文件末尾。
# ============================================================

# ---------- GitHub ----------
# 不填则使用匿名请求（速率限制 60 次/小时，很容易撞限）
# 生成地址: https://github.com/settings/tokens  (classic token，无需勾任何 scope)
GITHUB_TOKEN=

# 搜索近 N 天创建的项目。
# PRD 原定 3 天，但实测太窄 —— 符合 star 门槛的新项目每天就那么几个，
# 经常抓不满候选。15 天能稳定凑够 5 个候选，且配合候补池不会浪费素材。
SEARCH_DAYS=15
# 初筛候选数量（每天分析这么多个，推送其中最高分的 1 个）
CANDIDATE_COUNT=5
# 最低 star 门槛，过滤噪音仓库
MIN_STARS=10

# ---------- LLM ----------
# 换模型 / 换服务商：改下面三项，然后 `docker compose restart`。
# 改完看 `docker compose logs -f`，出现「启动自检通过 ✓」即可用；
# 也可以手动验：docker compose exec github-ai-insight python main.py --test-llm

# 必填。不填则全部分析降级为 GitHub 元数据摘要
LLM_API_KEY=

# ---- 服务商预设：启用哪组就取消注释哪组，其余注释掉 ----

# 阿里云百炼 MaaS 专属端点（把 <你的实例ID> 换成控制台给你的那串）
LLM_BASE_URL=https://llm-<你的实例ID>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=glm-5.2
LLM_PROVIDER=openai

# 阿里云百炼 公共端点（通义千问）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_PROVIDER=openai

# OpenAI 官方
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
# LLM_PROVIDER=openai

# Anthropic 官方（走 /messages 接口，provider 必须是 anthropic）
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_MODEL=claude-sonnet-4-5
# LLM_PROVIDER=anthropic

# DeepSeek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_PROVIDER=openai

# 本地 Ollama（Key 随便填个非空值；NAS 上用宿主机 IP，不能写 localhost）
# LLM_BASE_URL=http://192.168.1.100:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_PROVIDER=openai

# 其余 OpenAI 兼容服务：provider 填 openai，base_url 填到 /v1 为止
LLM_TIMEOUT=120
LLM_MAX_TOKENS=4096

# 常驻启动时发一次最小请求验证配置（约 256 token）。
# 换模型后重启能立刻发现配错，而不是等到第二天收到一条全降级的日报
STARTUP_LLM_CHECK=true

# ---------- 企业微信推送 ----------
# 群机器人 Webhook，不填则跳过推送（报告与归档照常生成）
WECHAT_WEBHOOK_URL=
# 去重后无候选、候补池也空时，是否推送「今日无新发现」
NOTIFY_EMPTY=false

# ---------- 报告访问 ----------
# 企微消息里「查看完整分析报告」的链接前缀。
# ⚠️ 这个地址必须是【手机在任何网络下都能访问到】的，否则链接是死的。
#
#   局域网 IP    http://192.168.1.100:8080/reports
#                只有连家里 WiFi 时能开，用流量点开是死链
#   Tailscale    http://100.x.x.x:8080/reports
#                装了 Tailscale 的手机在任何网络下都能开，且不对公网暴露
#   反向代理     https://nas.你的域名.com/reports
#                需要 DDNS + 证书；注意内置 HTTP 服务【没有任何鉴权】
#
# 内置服务基于 Python http.server，官方明确说明不适合直接暴露到公网。
# 要走公网请放在 Nginx / Caddy / Cloudflare Tunnel 后面，并自行加鉴权。
REPORT_BASE_URL=http://localhost:8080/reports
# 内置 HTTP 服务端口（改这项需要 docker compose up -d，不是 restart）
# ⚠️ 很多 NAS 的 8080 已被自带服务占用（极空间实测 8080 和 8088 都被占）。
# 部署前先确认端口空闲：nc -z <NAS_IP> 8080  或在 NAS 上 ss -tlnp | grep 8080
# compose 的映射两侧同号，改这里即同时改宿主机端口和容器内绑定端口。
HTTP_PORT=8080
# 是否在调度模式下同时启动 HTTP 服务
SERVE_REPORTS=true

# ---------- 调度 ----------
# 每日执行时间 HH:MM，按下面的 TIMEZONE 解释（不是宿主机时区）
EXECUTION_TIME=12:00
# 改这项需要 docker compose up -d，不是 restart
TIMEZONE=Asia/Dubai

# ---------- 运行时 ----------
# ⚠️ Docker 里这一项由 compose 强制设为 /app/data，改这里不生效。
# 要换 NAS 上的存储位置，改 docker-compose.yml 里 volumes 的宿主机侧路径。
DATA_DIR=./data
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------- TLS 信任链 ----------
# 本机有代理工具或杀毒软件在解密 HTTPS 时，Python 只认 certifi 自带的
# CA 包，访问 GitHub 会报 CERTIFICATE_VERIFY_FAILED（浏览器却正常）。
# 打开这项改用操作系统证书存储即可。不会关闭证书校验。
#
# 开发机上通常需要 true；NAS 容器里没有中间人，保持 false 即可
# （设成 true 也无害，容器读的是标准 ca-certificates）。
USE_SYSTEM_CERTS=false
# 或者直接指定一个 PEM 文件（例如从代理工具导出的根证书）
CA_BUNDLE=

# ============================================================
# 改完需要 `docker compose up -d` 重建（而非 restart）的项：
#   TIMEZONE / HTTP_PORT / PUID / PGID
# 其余全部 restart 即生效。
# ============================================================

# ============================================================
# GitHub AI Insight — 环境变量模板
# 复制为 .env 后填写：  cp .env.example .env
# 本地测试可以什么都不填，直接跑 python main.py --now --mock
# ============================================================

# ---------- GitHub ----------
# 不填则使用匿名请求（速率限制 60 次/小时，够用但容易撞限）
# 生成地址: https://github.com/settings/tokens  (无需任何 scope)
GITHUB_TOKEN=

# 搜索近 N 天创建的项目
SEARCH_DAYS=3
# 初筛候选数量
CANDIDATE_COUNT=5
# 最低 star 门槛，过滤噪音仓库
MIN_STARS=10

# ---------- LLM ----------
# 换模型 / 换服务商：改下面三项，然后 `docker compose restart`。
# .env 是以文件形式挂进容器的，重启即生效，不需要 up -d 重建。
# 改完用 `docker compose logs -f` 看「启动自检通过」，或
# `docker compose exec github-ai-insight python main.py --test-llm` 手动验。

# 必填。不填则全部分析降级为 GitHub 元数据摘要
LLM_API_KEY=

# ---- 常见服务商预设：把对应的三行取消注释，其余注释掉 ----

# OpenAI 官方
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_PROVIDER=openai

# Anthropic 官方（走 /messages 接口，provider 必须是 anthropic）
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_MODEL=claude-sonnet-4-5
# LLM_PROVIDER=anthropic

# 阿里云百炼 / DashScope 兼容模式
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_PROVIDER=openai

# DeepSeek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_PROVIDER=openai

# 本地 Ollama（Key 随便填个非空值；NAS 上注意用宿主机 IP 而非 localhost）
# LLM_BASE_URL=http://192.168.1.100:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_PROVIDER=openai

# 其余兼容服务：provider 填 openai，base_url 填到 /v1 为止

LLM_TIMEOUT=120
LLM_MAX_TOKENS=4096
# 常驻启动时发一次最小请求验证配置（约 256 token）。
# 换模型后重启能立刻发现配错，而不是等到第二天收到全降级的日报
STARTUP_LLM_CHECK=true

# ---------- 企业微信推送 ----------
# 群机器人 Webhook，不填则跳过推送（报告与归档照常生成）
WECHAT_WEBHOOK_URL=
# 去重后无候选项目时，是否推送"今日无新发现"
NOTIFY_EMPTY=false

# ---------- 报告访问 ----------
# 企微消息里的报告链接前缀。部署到 NAS 后改成 NAS 的局域网/公网地址，
# 否则手机上点开是打不开的
REPORT_BASE_URL=http://localhost:8080/reports
# 内置 HTTP 服务端口
HTTP_PORT=8080
# 是否在调度模式下同时启动 HTTP 服务
SERVE_REPORTS=true

# ---------- 调度 ----------
# 每日执行时间 HH:MM
EXECUTION_TIME=12:00
TIMEZONE=Asia/Dubai

# ---------- 运行时 ----------
# 注意：Docker 里这一项由 compose 强制设为 /app/data，改这里不生效。
# 要换 NAS 上的存储位置，改 docker-compose.yml 里 volumes 的宿主机侧路径。
DATA_DIR=./data
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------- TLS 信任链（仅开发机可能需要）----------
# 如果本机有代理工具或杀毒软件在解密 HTTPS，Python 只认 certifi 自带的 CA 包，
# 访问 GitHub 会报 CERTIFICATE_VERIFY_FAILED（浏览器却正常）。
# 打开下面这项改用操作系统证书存储即可（需要 pip install truststore）。
# 二者都不会关闭证书校验。容器里通常保持 false。
USE_SYSTEM_CERTS=false
# 或者直接指定一个 PEM 文件（例如从代理工具导出的根证书）
CA_BUNDLE=

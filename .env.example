# ============================================================
# GitHub AI Insight — 环境变量模板
# 复制为 .env 后填写：  cp .env.example .env
# 本地测试可以什么都不填，直接跑 python main.py --now --mock
# ============================================================

# ---------- GitHub ----------
# 不填则使用匿名请求（速率限制 60 次/小时，够用但容易撞限）
# 生成地址: https://github.com/settings/tokens  (无需任何 scope)
GITHUB_TOKEN=

# 搜索近 N 天创建的项目
SEARCH_DAYS=3
# 初筛候选数量
CANDIDATE_COUNT=5
# 最低 star 门槛，过滤噪音仓库
MIN_STARS=10

# ---------- LLM ----------
# 必填。不填则全部分析降级为 GitHub 元数据摘要
LLM_API_KEY=
# OpenAI 官方: https://api.openai.com/v1
# Anthropic:   https://api.anthropic.com/v1   （同时把 LLM_PROVIDER 改成 anthropic）
# 各类中转/兼容服务填对应的 base url 即可
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
# openai | anthropic
LLM_PROVIDER=openai
LLM_TIMEOUT=120
LLM_MAX_TOKENS=4096

# ---------- 企业微信推送 ----------
# 群机器人 Webhook，不填则跳过推送（报告与归档照常生成）
WECHAT_WEBHOOK_URL=
# 去重后无候选项目时，是否推送"今日无新发现"
NOTIFY_EMPTY=false

# ---------- 报告访问 ----------
# 企微消息里的报告链接前缀。部署到 NAS 后改成 NAS 的局域网/公网地址，
# 否则手机上点开是打不开的
REPORT_BASE_URL=http://localhost:8080/reports
# 内置 HTTP 服务端口
HTTP_PORT=8080
# 是否在调度模式下同时启动 HTTP 服务
SERVE_REPORTS=true

# ---------- 调度 ----------
# 每日执行时间 HH:MM
EXECUTION_TIME=12:00
TIMEZONE=Asia/Dubai

# ---------- 运行时 ----------
DATA_DIR=./data
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------- TLS 信任链（仅开发机可能需要）----------
# 如果本机有代理工具或杀毒软件在解密 HTTPS，Python 只认 certifi 自带的 CA 包，
# 访问 GitHub 会报 CERTIFICATE_VERIFY_FAILED（浏览器却正常）。
# 打开下面这项改用操作系统证书存储即可（需要 pip install truststore）。
# 二者都不会关闭证书校验。容器里通常保持 false。
USE_SYSTEM_CERTS=false
# 或者直接指定一个 PEM 文件（例如从代理工具导出的根证书）
CA_BUNDLE=
